PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/nodeTS-shopApi?retryWrites=true&w=majority
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
APP_BASE_URL=https://YOUR_PUBLIC_BACKEND_URL
FRONTEND_URL=http://localhost:5173
SSLCommerz_STORE_ID=YOUR_SANDBOX_STORE_ID
SSLCommerz_STORE_PASSWORD=YOUR_SANDBOX_STORE_PASSWORD
SSLCommerz_IS_LIVE=false
SHIPPING_FEE=60
ADMIN_NAME=Shop Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password
