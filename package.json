{
  "name": "nodets-shopapi",
  "version": "1.0.0",
  "description": "Raw Node.js HTTP E-commerce REST API with TypeScript, MongoDB Atlas and SSLCommerz",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch ./src/server.ts",
    "build": "tsc",
    "start": "node ./dist/server.js",
    "typecheck": "tsc --noEmit",
    "admin:create": "tsx ./src/scripts/createAdmin.ts"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "rest-api",
    "mongodb",
    "mongoose",
    "sslcommerz",
    "ecommerce"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.30",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.5.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.15.1",
    "swagger-ui-dist": "^5.35.0"
  }
}
